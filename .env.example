# MicroMart - Root / services environment template
# Copy to .env in each service directory (or use a single .env at root if your setup loads it).

# ---- User Service (services/user-service) ----
PORT=3004
MONGODB_URI=mongodb://localhost:27017/micromart-users
JWT_SECRET=your-jwt-secret-key

# ---- Product Service (services/product-service) ----
PORT=30011
MONGODB_URI=mongodb://localhost:27017/micromart-products
ORDER_SERVICE_URL=http://localhost:3001

# ---- Order Service (services/order-service) ----
PORT=3001
MONGODB_URI=mongodb://localhost:27017/micromart-orders

# ---- Inventory Service (services/inventory-service) ----
PORT=3003
MONGODB_URI=mongodb://localhost:27017/micromart-inventory
